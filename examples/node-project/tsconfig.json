{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "exclude": [
    "dist"
  ]
}
